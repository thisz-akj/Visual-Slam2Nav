 } //namespace ORB_SLAM
 
+
+namespace ORB_SLAM3
+{
+// [vslam] export the sparse map of every map in the atlas
+void System::SaveMapPoints(const string &filename)
+{
+    ofstream f(filename.c_str());
+    f << fixed << setprecision(6);
+    for (Map* pMap : mpAtlas->GetAllMaps())
+    {
+        for (MapPoint* pMP : pMap->GetAllMapPoints())
+        {
+            if (!pMP || pMP->isBad())
+                continue;
+            Eigen::Vector3f p = pMP->GetWorldPos();
+            f << pMap->GetId() << " " << p(0) << " " << p(1) << " " << p(2) << " " << pMP->Observations() << "\n";
+        }
+    }
+    f.close();
+    cout << endl << "Map points saved to " << filename << endl;
+}
+
+} // namespace ORB_SLAM3
